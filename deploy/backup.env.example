# Keep the real file root-owned, mode 600, OUTSIDE the project, e.g. /etc/sovereign-mail-backup.env.
# Use an SSH destination reachable from the mail server.
RESTIC_REPOSITORY=sftp:mailbackup@BACKUP_SERVER_ADDRESS:/srv/backups/sovereign-mail
RESTIC_PASSWORD_FILE=/etc/sovereign-mail-restic-password
# SSH keys and known_hosts belong to the user executing the backup job.
# Verify the backup server host key in advance. Never disable host-key checking.
