{
    email {$ACME_EMAIL}
    admin off
}
{$WEB_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    request_body {
        max_size 12MB
    }
    reverse_proxy webmail:8787
}
# Stalwart discovery, administration, JMAP, OAuth and autoconfiguration.
{$MX_HOST}, autoconfig.{$MAIL_DOMAIN}, autodiscover.{$MAIL_DOMAIN}, mta-sts.{$MAIL_DOMAIN}, ua-auto-config.{$MAIL_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }
    reverse_proxy stalwart:8080
}
# Lets Stalwart renew its SMTP/IMAP certificate using HTTP-01 when DNS-01 is
# unavailable. Configure HTTP-01 in Stalwart; TLS-ALPN-01 cannot work through Caddy.
http://{$MX_HOST}, http://autoconfig.{$MAIL_DOMAIN}, http://autodiscover.{$MAIL_DOMAIN}, http://mta-sts.{$MAIL_DOMAIN}, http://ua-auto-config.{$MAIL_DOMAIN} {
    handle /.well-known/acme-challenge/* {
        reverse_proxy stalwart:8080
    }
    handle {
        redir https://{host}{uri} permanent
    }
}
