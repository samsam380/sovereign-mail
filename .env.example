MAIL_DOMAIN=example.com
WEB_HOST=mail.example.com
MX_HOST=mx.example.com
# Replace with an existing external email address, so certificate alerts arrive
# before your new mailbox is operational.
ACME_EMAIL=REPLACE_WITH_YOUR_EXISTING_EMAIL
# Official major-version channels; reviewed upgrades are explicit (no auto-updater).
# After first successful validation, record/pin the pulled images by digest.
STALWART_IMAGE=stalwartlabs/stalwart:v1
CADDY_IMAGE=caddy:2-alpine
